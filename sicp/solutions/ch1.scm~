(define (mul a b)
  (cond
    ((= b 0) 0)
    ((even? b) (double (mul a (halve b))))
    (else (+ a (mul a (- b 1))))))
; 1.18
(define (mul a b n)
  (cond
    ((= b 0) n)
    ((even? b) (mul (double a) (halve b) n))
    (else (mul a (- b 1) (+ n a)))))

(define (sum term a next b result)
  (if (> a b) result
      (sum term (next a) next b (+ result (term a)))))


(define product
  (lambda (x y term next)
    (if (> x y) 1
        (* (term x) (product (next x) y term next)))))
(define (product-iter x y next term acc)
  (if (> x y) acc
      (prodcut-iter (next x) y next term (* (term x) acc))))
